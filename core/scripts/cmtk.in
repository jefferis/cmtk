if [ -z "${CMTK_BINARY_DIR}" ]; then
    script_dir=`CDPATH= cd -- "\`dirname -- "$0"\`" && pwd`
    if [ -d "${script_dir}/../lib/cmtk/bin" ]; then
        CMTK_BINARY_DIR=`CDPATH= cd -- "${script_dir}/../lib/cmtk/bin" && pwd`
    elif [ -d "${script_dir}" ] && [ "\`basename -- "${script_dir}"\`" = "bin" ] && [ "\`basename -- "\`dirname -- "${script_dir}"\`"\`" = "cmtk" ]; then
        CMTK_BINARY_DIR="${script_dir}"
    else
        CMTK_BINARY_DIR=@CMTK_BINARY_DIR_CONFIG@
    fi
fi
export CMTK_BINARY_DIR

if [ -z "${CMTK_LIBRARY_DIR}" ]; then
    if [ -d "${CMTK_BINARY_DIR}/.." ]; then
        CMTK_LIBRARY_DIR=`CDPATH= cd -- "${CMTK_BINARY_DIR}/.." && pwd`
    else
        CMTK_LIBRARY_DIR=@CMTK_LIBRARY_DIR_CONFIG@
    fi
fi
export CMTK_LIBRARY_DIR

CMD=$1
CMDPATH=${CMTK_BINARY_DIR}/$CMD
shift

if [ "${LD_LIBRARY_PATH}" != "" ]; then
    export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:${CMTK_LIBRARY_DIR}
else
    export LD_LIBRARY_PATH=${CMTK_LIBRARY_DIR}
fi

if echo "$CMD $@" | grep -q -e --help; then
    [ "$CMD" = "--help" ] && man cmtk || man <( ${CMDPATH} --man )
else
    ${CMDPATH} "$@"
fi

# "exit" without argument will forward exit code of last executed command
exit
